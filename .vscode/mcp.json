{
	"servers": {
		"playwright-test": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"playwright",
				"run-test-mcp-server"
			]
		},
		"playwright": {
			"type": "stdio",
			"sandboxEnabled": true,
			"command": "npx",
			"cwd": "${input:cwd}",
			"args": [
				"@playwright/mcp@0.0.75"
			],
			"dev": {
				"watch": [],
				"debug": {
					"type": "node"
				}
			}
		}
	},
	"inputs": [
		{
			"id": "cwd",
			"type": "promptString",
			"description": "Working Directory"
		}
	]
}